<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.zextras.carbonio.quarkus</groupId>
    <artifactId>carbonio-quarkus-extensions-parent</artifactId>
    <version>1.16.3-172.0f9643d3-SNAPSHOT</version>
    <relativePath/>
  </parent>

  <licenses>
    <license>
      <comments>Copyright (C) 2026 Zextras, https://www.zextras.com</comments>
      <name>AGPL-3.0-only</name>
    </license>
  </licenses>

  <groupId>com.zextras.carbonio.docs-connector</groupId>
  <artifactId>carbonio-docs-connector-ce</artifactId>
  <version>${revision}${changelist}</version>
  <packaging>pom</packaging>

  <name>carbonio-docs-connector-ce</name>

  <modules>
    <module>app</module>
  </modules>

  <properties>
    <assertj.version>3.27.7</assertj.version>
    <carbonio-files-ce-rest-sdk.version>2.1.0-1</carbonio-files-ce-rest-sdk.version>

    <revision>2.2.8</revision>
    <changelist>-SNAPSHOT</changelist>
  </properties>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>flatten-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>flatten</id>
            <phase>validate</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <repositories>
    <repository>
      <id>zextras-nexus</id>
      <url>https://repo.zextras.tools/repository/java-sdk/</url>
      <releases><enabled>true</enabled></releases>
      <snapshots><enabled>true</enabled></snapshots>
    </repository>
  </repositories>

  <distributionManagement>
    <repository>
      <id>nexus-prod</id>
      <name>Zextras releases</name>
      <url>https://repo.zextras.tools/repository/public-maven-repo/</url>
    </repository>
    <snapshotRepository>
      <id>nexus-prod</id>
      <name>Zextras snapshots</name>
      <url>https://repo.zextras.tools/repository/maven-snapshots/</url>
    </snapshotRepository>
  </distributionManagement>

  <profiles>
    <profile>
      <id>dev</id>
      <activation><activeByDefault>true</activeByDefault></activation>
      <properties><changelist>-SNAPSHOT</changelist></properties>
    </profile>
    <profile>
      <id>prod</id>
      <properties><changelist></changelist></properties>
    </profile>
  </profiles>
</project>
