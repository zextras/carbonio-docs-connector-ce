[Unit]
Description=Carbonio Docs Connector
Wants=network.target
Requires=network-online.target
After=network-online.target
PartOf=carbonio.target

[Service]
Type=simple
ExecStart=/usr/bin/carbonio-docs-connector
User=carbonio-docs-connector
Group=carbonio-docs-connector
Restart=on-failure
RestartSec=15s
TimeoutSec=60s
TimeoutStopSec=120s
# The JVM exits with 128+SIGTERM when stopped
SuccessExitStatus=143


[Install]
WantedBy=carbonio.target multi-user.target
